{
  "manifest_version": 3,
  "name": "gryphOS",
  "version": "2.3.0",
  "description": "gryphOS \u2014 local CourseLink academic OS. Cinematic brief, command surface, living My Day. Brave / Opera GX / Chromium.",
  "permissions": [
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://courselink.uoguelph.ca/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "gryphOS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://courselink.uoguelph.ca/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "assets/*",
        "pdf.worker.min.mjs"
      ],
      "matches": [
        "https://courselink.uoguelph.ca/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
