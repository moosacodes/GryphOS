{
  "manifest_version": 3,
  "name": "gryphOS",
  "version": "1.0.0",
  "description": "Privacy-first local-first academic OS for University of Guelph CourseLink.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://courselink.uoguelph.ca/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "gryphOS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://courselink.uoguelph.ca/d2l/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
